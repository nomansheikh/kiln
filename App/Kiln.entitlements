<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime keeps the microphone from an app that does not ask for it.
	     Kiln records only when the user presses Record on the composer. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
